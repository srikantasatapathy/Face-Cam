# ---------------------------------------------------------------------------
# Face-Cam environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# Postgres must have the `vector` (pgvector) and `pgcrypto` extensions enabled.
DATABASE_URL=postgresql://user:password@localhost:5436/facecam_db

# --- Application database role -------------------------------------------
# The app connects as a NON-OWNER role so Postgres Row Level Security actually
# binds it. DATABASE_URL (a superuser) is used only for migrations and for
# explicit platform-level queries, which must span every tenant.
APP_DATABASE_PASSWORD=change-me
APP_DATABASE_URL=postgresql://facecam_app:change-me@localhost:5436/facecam_db

# --- App ------------------------------------------------------------------
# NODE_ENV is set by the runtime (next/nest), not here
API_PORT=4000
WEB_PORT=3100
API_URL=http://localhost:4000
WEB_URL=http://localhost:3100
# Root domain used for tenant subdomain resolution (<slug>.<ROOT_DOMAIN>)
ROOT_DOMAIN=localhost:3100

# --- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
# 32-byte key, base64. Encrypts CompreFace API keys at rest.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# --- File storage ---------------------------------------------------------
# local -> writes to LOCAL_UPLOAD_DIR ; aws -> writes to AWS_S3_BUCKET
FILE_UPLOAD=local
LOCAL_UPLOAD_DIR=./uploads
AWS_REGION=
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Signed URL lifetime in seconds
SIGNED_URL_TTL=300

# --- CompreFace -----------------------------------------------------------
COMPREFACE_URL=http://localhost:8000
# Admin credentials, NOT a recognition API key. Creating a per-tenant face
# collection is an admin-API operation. Create a dedicated service account in
# the CompreFace UI rather than reusing a person's login.
COMPREFACE_ADMIN_EMAIL=
COMPREFACE_ADMIN_PASSWORD=
# CompreFace ships these fixed; override only if you changed them.
COMPREFACE_CLIENT_ID=CommonClientId
COMPREFACE_CLIENT_SECRET=password

# --- Anti-spoofing --------------------------------------------------------
ANTISPOOF_URL=http://localhost:8081
ANTISPOOF_ENABLED=true
# log -> record score only ; enforce -> reject above tenant threshold
ANTISPOOF_MODE=log

# --- Redis ----------------------------------------------------------------
REDIS_URL=redis://localhost:6379

# --- Email ----------------------------------------------------------------
# resend | ses | postmark | console (console logs instead of sending)
MAIL_PROVIDER=console
MAIL_API_KEY=
MAIL_FROM=no-reply@facecam.local

# --- Web (Next.js public vars) --------------------------------------------
# Must be prefixed NEXT_PUBLIC_ to reach the browser bundle.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ROOT_DOMAIN=localhost:3100

# CompreFace: keep a copy of enrollment images in its own database.
# false (default) = embeddings only; its Subjects screen shows blank thumbnails.
# true = thumbnails work, but a second copy of every face lives outside our
# retention controls. Use only for local development. false in production.
COMPREFACE_SAVE_IMAGES=false
